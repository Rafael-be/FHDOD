# Runtime connection: restricted fhdod_api role; never use this for DDL.
DATABASE_URL=postgres://fhdod_api:change-me@localhost:5432/fhdod
# Administrative connection used only for bootstrap/introspection/migrations.
DATABASE_URL_MIGRATIONS=postgres://postgres:change-me@localhost:5432/fhdod
# Dedicated external maintenance job; never use fhdod_api or an administrative URL.
AUDIT_RETENTION_DATABASE_URL=
# A separate local disposable test database. Integration tests reject remote
# hosts and database names other than fhdod_test or fhdod_test_*.
DATABASE_URL_TEST=postgres://fhdod_test:change-me@127.0.0.1:54329/fhdod_test
# Preferred integration-test URL. It must remain loopback-only and disposable.
LOCAL_DATABASE_URL=postgres://fhdod_test:change-me@127.0.0.1:54329/fhdod_test
PORT=3000
NODE_ENV=development
ALLOWED_ORIGIN=http://localhost:5173
JWT_SECRET=replace-with-at-least-32-random-bytes
JWT_ISSUER=fhdod-api
JWT_AUDIENCE=fhdod-web
# Set to true temporarily to emit structured, secret-free stage timings.
PERFORMANCE_MEASUREMENTS=false
# Used only by the explicit seed command; do not commit its value.
INITIAL_SUPERUSER_NAME=
INITIAL_SUPERUSER_EMAIL=
INITIAL_SUPERUSER_PASSWORD=

# Redis is optional and fail-open. Enable only when Redis is available.
CACHE_ENABLED=false
REDIS_URL=redis://127.0.0.1:6379
# TTL for effective question lists (30-120 seconds).
CACHE_QUESTIONS_TTL_SECONDS=60
# Redis distributed security controls; failures fall back to bounded local state.
SECURITY_REDIS_ENABLED=true
# Trust forwarded IPs only when the deployment has a known trusted reverse proxy.
# Comma-separated IP/CIDR allowlist for the reverse proxy; empty means no proxy is trusted.
TRUSTED_PROXY_CIDRS=
RATE_LIMIT_LOGIN_PER_IP=30
RATE_LIMIT_ADMIN_PER_IP=300
RATE_LIMIT_SUBMISSION_PER_IP=180
LOGIN_FAILURE_LIMIT_PER_IP=5
LOGIN_FAILURE_LIMIT_PER_IDENTIFIER=5
LOGIN_BLOCK_BASE_SECONDS=1
LOGIN_BLOCK_MAX_SECONDS=60
