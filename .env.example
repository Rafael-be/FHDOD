# Runtime connection: restricted fhdod_api role; never use this for DDL.
DATABASE_URL=postgres://fhdod_api:change-me@localhost:5432/fhdod
# Administrative connection used only for bootstrap/introspection/migrations.
DATABASE_URL_MIGRATIONS=postgres://postgres:change-me@localhost:5432/fhdod
# Dedicated external maintenance job; never use fhdod_api or an administrative URL.
AUDIT_RETENTION_DATABASE_URL=
# A separate disposable test database. Tests never fall back to DATABASE_URL.
DATABASE_URL_TEST=
PORT=3000
NODE_ENV=development
ALLOWED_ORIGIN=http://localhost:5173
JWT_SECRET=replace-with-at-least-32-random-bytes
JWT_ISSUER=fhdod-api
JWT_AUDIENCE=fhdod-web
# Set to true temporarily to emit structured, secret-free stage timings.
PERFORMANCE_MEASUREMENTS=false
# Used only by the explicit seed command; do not commit its value.
INITIAL_SUPERUSER_NAME=
INITIAL_SUPERUSER_EMAIL=
INITIAL_SUPERUSER_PASSWORD=
